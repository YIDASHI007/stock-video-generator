APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8877
APP_DATA_DIR=./data
APP_LOG_DIR=./logs
APP_RUNTIME_DIR=.
# 正式安装包会把前端构建目录写入此项；开发模式通常无需设置。
# APP_WEB_DIST_DIR=./apps/web/dist
APP_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
NODE_EXECUTABLE=node
MARKET_CACHE_RECENT_TTL_SECONDS=1800
MARKET_CACHE_HISTORICAL_TTL_SECONDS=2592000
MARKET_REQUEST_TIMEOUT_SECONDS=30
RENDER_MAX_CONCURRENCY=1
FETCH_MAX_CONCURRENCY=3
SIMULATION_MAX_CONCURRENCY=4
TTS_MAX_CONCURRENCY=2
FETCH_TIMEOUT_SECONDS=90
RENDER_TIMEOUT_SECONDS=900
MINIMUM_FREE_DISK_BYTES=2147483648
PUBLISH_HEADLESS=false
PUBLISH_BROWSER_CHANNEL=chrome
PUBLISH_STEP_TIMEOUT_SECONDS=90
PUBLISH_UPLOAD_TIMEOUT_SECONDS=900
PUBLISH_MAX_AGENT_FALLBACKS=3
# Optional. If omitted, the API uses apps/publisher-agent/dist/index.js after pnpm build.
# PUBLISH_AGENT_COMMAND=node apps/publisher-agent/dist/index.js
PUBLISH_AGENT_MODEL=openai/gpt-4.1-mini
# OPENAI_API_KEY=replace-me
VITE_API_BASE_URL=http://127.0.0.1:8877
